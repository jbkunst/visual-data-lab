\name{input_label_vdl}
\alias{input_label_vdl}
\title{Input label with contextual help}
\usage{
input_label_vdl(label, help, placement = "right")
}
\arguments{
  \item{label}{Label text or HTML content.}
  \item{help}{Short explanation shown in a tooltip.}
  \item{placement}{Bootstrap tooltip placement.}
}
\value{
An HTML label suitable for a Shiny input.
}
\description{
Creates a compact input label with a keyboard- and touch-accessible help icon.
}
